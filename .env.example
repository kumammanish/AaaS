# ===================================================================
# Architecture as a Service - Configuration Template
# ===================================================================
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Choose ONE AI provider (Gemini recommended - FREE)
# 3. Get API key from provider's website
# 4. Paste your API key in .env file (NOT this file!)
# 5. Save and run: python app.py
#
# ===================================================================

# ===== AI PARSER TOGGLE =====
# Enable AI-powered architecture generation (requires API key)
# Set to 'false' to use simple keyword-based parser (no AI needed)
USE_AI_PARSER=true

# ===== AI PROVIDER =====
# Choose ONE provider: gemini | openai | anthropic | azure_openai
#
# RECOMMENDED: gemini
# - FREE tier: 60 requests/minute
# - Fast: ~1-2 seconds per diagram
# - Cost: $0.0001 per request (if exceeding free tier)
#
AI_PROVIDER=gemini

# ===== MCP (Azure Best Practices) =====
# Enable built-in Azure architecture knowledge
# Provides intelligent service suggestions and connections
# FREE - no API key needed
USE_MCP=true

# ===== AUTOMATIC FAILOVER =====
# Configure multiple API keys for automatic failover
# If primary provider fails (expired token, quota exceeded), 
# system automatically switches to backup providers
#
# Example: Set AI_PROVIDER=gemini as primary
# Add OPENAI_API_KEY and ANTHROPIC_API_KEY as backups
# Failover order: gemini → openai → anthropic
#
# Failover triggers:
# - Expired API keys (401, 403 errors)
# - Rate limits exceeded (429 errors)
# - Quota exhausted
#

# ===================================================================
# OPTION 1: GOOGLE GEMINI (⭐ RECOMMENDED - FREE TIER)
# ===================================================================
#
# Get your FREE API key:
#   1. Visit: https://aistudio.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy the key (starts with AIza...)
#   4. Paste below (remove "your-google-api-key-here")
#
# Benefits:
#    60 requests/minute FREE
#    Fast response (~1-2 seconds)
#    Latest Gemini 2.5 Flash model
#    $0.0001 per request if exceeding free tier
#
GOOGLE_API_KEY=your-google-api-key-here

# Model options (gemini-2.5-flash recommended):
# - gemini-2.5-flash (fastest, FREE tier, best value)
# - gemini-1.5-pro (better quality, slower)
GEMINI_MODEL=gemini-2.5-flash

# ===================================================================
# OPENAI (GPT-3.5, GPT-4)
# Get API key: https://platform.openai.com/api-keys
# No free tier, but cheap for GPT-3.5-turbo
# Cost: GPT-3.5-turbo = $0.002/request, GPT-4 = $0.03/request
# ===================================================================
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model options:
# - gpt-3.5-turbo (fast, cheap, good quality)
# - gpt-4 (best quality, expensive)
# - gpt-4-turbo (faster GPT-4)
OPENAI_MODEL=gpt-3.5-turbo

# ===================================================================
# ANTHROPIC CLAUDE
# Get API key: https://console.anthropic.com/
# No free tier
# Cost: Claude 3.5 Sonnet = $0.015/request
# ===================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Anthropic model options:
# - claude-3-5-sonnet-20241022 (recommended, best balance)
# - claude-3-opus-20240229 (highest quality, slower)
# - claude-3-haiku-20240307 (fastest, cheaper)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===================================================================
# AZURE OPENAI SERVICE
# Enterprise option - data stays in your Azure tenant
# Setup: Azure Portal → Create OpenAI resource
# Cost: Similar to OpenAI pricing
# ===================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===================================================================
# COST COMPARISON (per 1000 requests)
# ===================================================================
# Keywords (current):      $0 (free)
# Gemini Flash:            $0.10
# Gemini Pro:              $0.50
# GPT-3.5 Turbo:           $2.00
# Claude 3.5 Sonnet:       $15.00
# GPT-4:                   $30.00
# ===================================================================

# ===================================================================
# EXAMPLE CONFIGURATIONS
# ===================================================================

# Configuration 1: Free Development (Keywords Only)
# USE_AI_PARSER=false

# Configuration 2: Gemini Free Tier (Recommended for Testing)
# USE_AI_PARSER=true
# AI_PROVIDER=gemini
# GOOGLE_API_KEY=your-key
# GEMINI_MODEL=gemini-1.5-flash
# USE_MCP=true

# Configuration 3: Production (Gemini Pro + MCP)
# USE_AI_PARSER=true
# AI_PROVIDER=gemini
# GOOGLE_API_KEY=your-key
# GEMINI_MODEL=gemini-1.5-pro
# USE_MCP=true

# Configuration 4: Premium (GPT-4)
# USE_AI_PARSER=true
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=gpt-4

# Configuration 5: Enterprise (Azure OpenAI)
# USE_AI_PARSER=true
# AI_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4
